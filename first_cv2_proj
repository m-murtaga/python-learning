import cv2

video = cv2.VideoCapture(0)

ret1, frame1 = video.read()
ret2, frame2 = video.read()

if not ret1 or not ret2:
    print("تعذر القراءة! جرب تغيير رقم الكاميرا في cv2.VideoCapture")
    video.release()
    exit()

previous_motion_area = 0

while video.isOpened():
    diff = cv2.absdiff(frame1, frame2)
    gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)


    blur = cv2.GaussianBlur(gray, (5, 5), 0)


    _, thresh = cv2.threshold(blur, 20, 255, cv2.THRESH_BINARY)
    dilated = cv2.dilate(thresh, None, iterations=3)

    contours, _ = cv2.findContours(
        dilated, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE
    )

    total_motion_area = 0

    for contour in contours:
        area = cv2.contourArea(contour)


        if area < 1200:
            continue

        total_motion_area += area

        (x, y, w, h) = cv2.boundingRect(contour)

        cv2.rectangle(frame1, (x, y), (x + w, y + h), (0, 255, 0), 2)

    motion_speed = abs(total_motion_area - previous_motion_area)
    previous_motion_area = total_motion_area


    cv2.putText(
        frame1,
        f"Cars Motion: {int(total_motion_area)} px",
        (10, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 255),
        2,
    )
    cv2.putText(
        frame1,
        f"Speed: {int(motion_speed)} px/f",
        (10, 70),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (255, 255, 0),
        2,
    )

    if motion_speed > 3000:
        cv2.putText(
            frame1,
            "HIGH SPEED MOTION!",
            (10, 110),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 0, 255),
            2,
        )

    cv2.imshow("متعقب الحركة m.m", frame1)

    frame1 = frame2
    ret, frame2 = video.read()

    if not ret:
        break

    if cv2.waitKey(1) & 0xFF == 27:
        break

video.release()
cv2.destroyAllWindows()
